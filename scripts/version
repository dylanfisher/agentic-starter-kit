#!/usr/bin/env bash
# Bump the version in VERSION: ./scripts/version <major|minor|patch>
# Which level a commit takes is in docs/writing.md#versioning. Prints the new version.
set -euo pipefail
cd "$(dirname "$0")/.."

level="${1:-}"
current=$(cat VERSION)
if ! [[ "$current" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  echo "VERSION holds '$current', not MAJOR.MINOR.PATCH." >&2; exit 1
fi
major=${BASH_REMATCH[1]} minor=${BASH_REMATCH[2]} patch=${BASH_REMATCH[3]}

case "$level" in
  major) next="$((major + 1)).0.0" ;;
  minor) next="$major.$((minor + 1)).0" ;;
  patch) next="$major.$minor.$((patch + 1))" ;;
  *) echo "usage: ./scripts/version <major|minor|patch>" >&2; exit 1 ;;
esac

printf '%s\n' "$next" > VERSION
echo "$current → $next"
